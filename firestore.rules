rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email; }
    // The owner is always an admin and can never be removed
    function isOwner() { return signedIn() && me() == 'spartanbiolabs.info@gmail.com'; }
    function onTeam() { return signedIn() && exists(/databases/$(database)/documents/team/$(me())); }
    function tier() { return get(/databases/$(database)/documents/team/$(me())).data.role; }
    function isAdmin() { return isOwner() || (onTeam() && tier() == 'admin'); }
    function isStaff() { return isAdmin() || (onTeam() && tier() == 'rep'); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function validWebOrder(id, d) {
      return id.matches('^SB-[0-9]{6}-[A-Z0-9]{4}$') && d.id == id
        && d.keys().hasOnly(['id','source','status','date','name','addr','notes','pay','items','disc','shipping','subtotal','total','paidDate','tracking','deducted','created','updated'])
        && d.keys().hasAll(['id','source','status','date','name','addr','pay','items','shipping','subtotal','total','created'])
        && d.source == 'web' && d.status == 'awaiting' && d.pay in ['Zelle', 'Crypto', 'Card']
        && str(d.date, 10, 10) && str(d.name, 1, 100) && str(d.addr, 1, 400) && (!('notes' in d) || str(d.notes, 0, 1000))
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 40
        && d.shipping is number && d.subtotal is number && d.total is number
        && (!('deducted' in d) || d.deducted == false) && (!('tracking' in d) || d.tracking == '') && (!('paidDate' in d) || d.paidDate == '')
        && str(d.created, 10, 40);
    }

    // ----- Team list (Admin page > Team) -----
    match /team/{email} {
      allow read: if isAdmin() || (signedIn() && email == me());
      allow create, update: if isAdmin() && email != 'spartanbiolabs.info@gmail.com'
        && request.resource.data.role in ['admin', 'rep'];
      allow delete: if isAdmin() && email != 'spartanbiolabs.info@gmail.com';
    }

    // ----- Ops desk -----
    // Sales reps: invoices + orders (and the stock count that drops when they ship). Admins: everything.
    match /orders/{id} {
      allow read, update: if isStaff();
      // Website checkout can drop a NEW order in (it can't read, change or delete anything)
      allow create: if isStaff() || validWebOrder(id, request.resource.data);
      allow delete: if isAdmin();
    }
    match /inventory/{id} { allow read, create, update: if isStaff(); allow delete: if isAdmin(); }
    match /meta/{id}      { allow read: if isStaff(); allow write: if isAdmin(); }
    match /supply/{id}    { allow read, write: if isAdmin(); }

    // ----- Visit counts for Admin > Analytics -----
    // stats/<YYYY-MM>~<key> holds one number per day (d01..d31). Anyone may add exactly 1 to TODAY's number
    // (days on US Mountain time, UTC-6) and nothing else; only admins can read or clear them.
    function statDay() { return request.time - duration.value(6, 'h'); }
    function two(n) { return n < 10 ? '0' + string(n) : string(n); }
    function statMonth() { return string(statDay().year()) + '-' + two(statDay().month()); }
    function statField() { return 'd' + two(statDay().day()); }
    function validStat(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}~(v|pv-[a-z]{2,12}|p-[a-z0-9-]{1,40}|a-[a-z0-9-]{1,40}|c-[a-z0-9-]{1,30}|s-[a-z]{2,12}|dv-[a-z]{2,10})$')
        && id.split('~')[0] == statMonth()
        && (resource == null
              ? request.resource.data.keys().hasOnly([statField()]) && request.resource.data[statField()] == 1
              : request.resource.data.diff(resource.data).affectedKeys().hasOnly([statField()])
                && request.resource.data[statField()] == resource.data.get(statField(), 0) + 1);
    }
    match /stats/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if validStat(id);
    }

    // ----- Public store: anyone can view, only admins can change -----
    match /store/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /storeProducts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /storeImages/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /storeCoas/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /storeCoaFiles/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
